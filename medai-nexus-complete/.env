# ─── MedAI Nexus — Environment Template ─────
# Copy to .env and fill in your values
# NEVER commit .env to git

# ── App ───────────────────────────────────────
APP_ENV=development                 # development | production
DEBUG=true
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_STRING_FOR_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://medai:medai_secure_pw@localhost:5432/medai_nexus
POSTGRES_PASSWORD=medai_secure_pw

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://:redis_secure_pw@localhost:6379/0
REDIS_PASSWORD=redis_secure_pw

# ── AI / LLM ──────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ── Vector Database ───────────────────────────
VECTOR_DB=chroma                    # chroma | pinecone
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Pinecone (optional alternative to Chroma)
# PINECONE_API_KEY=pcsk_...
# PINECONE_INDEX=medai-embeddings

# ── Google Maps ───────────────────────────────
# Get from: https://console.cloud.google.com
GOOGLE_MAPS_KEY=AIza...

# ── Email (Medicine Reminders) ────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password  # Gmail App Password

# ── CORS ──────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://medai-nexus.vercel.app

# ── Frontend (Next.js) ────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_GOOGLE_MAPS=${GOOGLE_MAPS_KEY}

# ── Deploy (CI/CD) ────────────────────────────
# Set these in GitHub Secrets, not here:
# DEPLOY_HOST, DEPLOY_USER, DEPLOY_SSH_KEY
# SLACK_WEBHOOK (optional deployment notifications)
